{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joona-t/glyph-grid-studio/schema/preset/v1.json",
  "title": "Glyph Grid Studio preset",
  "description": "A preset is a partial CONFIG: every key is optional and deep-merges onto the renderer defaults. Generated by scripts/gen-schema.js from the live CONFIG — do not edit by hand.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema this preset was written against."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Preset format version.",
      "default": 1
    },
    "compat": {
      "description": "Pipeline generation switch. \"v1\" disables every v2 stage gate.",
      "type": "string",
      "enum": [
        "v1",
        "v2"
      ],
      "default": "v2"
    },
    "renderer": {
      "description": "Render substrate. webgl is opt-in and falls back to cpu.",
      "type": "string",
      "enum": [
        "cpu",
        "webgl"
      ],
      "default": "cpu"
    },
    "canvas": {
      "description": "Canvas size in px before fit-to-image.",
      "type": "object",
      "properties": {
        "w": {
          "type": "number",
          "default": 1024
        },
        "h": {
          "type": "number",
          "default": 504
        }
      },
      "additionalProperties": true
    },
    "grid": {
      "description": "Glyph grid dimensions (cells).",
      "type": "object",
      "properties": {
        "cols": {
          "type": "number",
          "default": 240
        },
        "rows": {
          "type": "number",
          "default": 120
        }
      },
      "additionalProperties": true
    },
    "font": {
      "description": "Glyph font family and pixel size.",
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "default": "monospace"
        },
        "size": {
          "type": "number",
          "default": 8
        }
      },
      "additionalProperties": true
    },
    "ramp": {
      "description": "Density ramp used by brightness selection.",
      "type": "string",
      "enum": [
        "classic",
        "dense",
        "sparse",
        "unicode-block",
        "gradient",
        "gradientNoSpace",
        "blockShaded",
        "blockAscend",
        "radial"
      ],
      "default": "gradient"
    },
    "brightnessGamma": {
      "description": "Curve on source brightness; <0.5 = high-contrast stipple.",
      "type": "number",
      "default": 0.55
    },
    "bgThreshold": {
      "description": "Source luminance above this renders as palette bg. 0 = off.",
      "type": "number",
      "default": 0
    },
    "invertSignal": {
      "description": "Flip bright/dark so dark detail becomes ink.",
      "type": "boolean",
      "default": false
    },
    "samplingStrategy": {
      "description": "How a cell reads its source pixels.",
      "type": "string",
      "enum": [
        "average",
        "nearest",
        "edge-weighted"
      ],
      "default": "average"
    },
    "colorMode": {
      "description": "How the palette maps to cells.",
      "type": "string",
      "enum": [
        "preserve",
        "monochrome",
        "duotone",
        "gradient"
      ],
      "default": "monochrome"
    },
    "palette": {
      "description": "Background colour + ink stops.",
      "type": "string",
      "enum": [
        "monochrome",
        "phosphor",
        "bauhaus",
        "lovespark",
        "mono-amber",
        "cyber-phosphor",
        "amber-phosphor",
        "bone-charcoal",
        "cream-paper",
        "silver-charcoal",
        "spice",
        "kawaii-pink"
      ],
      "default": "cream-paper"
    },
    "scene": {
      "description": "Built-in scene (studio renders the loaded source).",
      "type": "string",
      "enum": [
        "caduceusHelix",
        "flowField",
        "sparkyPortrait",
        "depthSmoke",
        "studio",
        "concentricRings"
      ],
      "default": "studio"
    },
    "animation": {
      "description": "Loop timing. Frames for `--frames auto` derive from duration x fps.",
      "type": "object",
      "properties": {
        "fps": {
          "type": "number",
          "default": 30
        },
        "duration": {
          "type": "number",
          "default": 6
        },
        "loop": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": true
    },
    "seed": {
      "description": "Deterministic seed for noise, dither phase and jitter.",
      "type": "number",
      "default": 1337
    },
    "record": {
      "description": "Internal recording flag.",
      "type": "boolean",
      "default": false
    },
    "glyphSet": {
      "description": "Shape atlas for shape selection modes; null = ramp only.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "ascii",
        "asciiDense",
        "blockElements",
        "braille",
        "octant",
        "sextant"
      ],
      "default": null
    },
    "selectionMode": {
      "description": "How glyphs are picked per cell.",
      "type": "string",
      "enum": [
        "brightness",
        "shape",
        "shape-edge-aware",
        "edge-directional",
        "flow"
      ],
      "default": "brightness"
    },
    "dither": {
      "description": "Quantization noise pattern (brightness selection only).",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "bayer4",
            "bayer8",
            "blueNoise",
            "temporal",
            "stbn",
            "floydSteinberg",
            "atkinson",
            "jarvisJudiceNinke"
          ],
          "default": "temporal"
        },
        "asSourcePrefilter": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": true
    },
    "prefilter": {
      "description": "Source-wide preprocessing.",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "xdog"
          ],
          "default": "none"
        }
      },
      "additionalProperties": true
    },
    "postprocess": {
      "description": "Per-stage post effects; each stage has `enabled` plus its params.",
      "type": "object",
      "properties": {
        "vignette": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "strength": {
              "type": "number",
              "default": 0.55
            }
          },
          "additionalProperties": true
        },
        "bloom": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "radius": {
              "type": "number",
              "default": 2.5
            },
            "strength": {
              "type": "number",
              "default": 0.95
            }
          },
          "additionalProperties": true
        },
        "halation": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "strength": {
              "type": "number",
              "default": 0.7
            }
          },
          "additionalProperties": true
        },
        "scanlines": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": true
        },
        "chromaticAberration": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": true
        },
        "phosphorDecay": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": true
        },
        "depthFog": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": true
        },
        "crtBeam": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "intensity": {
              "type": "number",
              "default": 0.45
            },
            "beamWidth": {
              "type": "number",
              "default": 0.18
            },
            "speed": {
              "type": "number",
              "default": 1
            },
            "slotMask": {
              "type": "boolean",
              "default": true
            },
            "slotStrength": {
              "type": "number",
              "default": 0.2
            }
          },
          "additionalProperties": true
        },
        "kawaii": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "intensity": {
              "type": "number",
              "default": 0.85
            },
            "heartCount": {
              "type": "number",
              "default": 12
            },
            "sparkleCount": {
              "type": "number",
              "default": 28
            },
            "twinkleCount": {
              "type": "number",
              "default": 60
            },
            "speed": {
              "type": "number",
              "default": 1
            },
            "hueR": {
              "type": "number",
              "default": 255
            },
            "hueG": {
              "type": "number",
              "default": 105
            },
            "hueB": {
              "type": "number",
              "default": 180
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "depth": {
      "description": "Depth-map fog zones.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "paletteMorph": {
      "description": "OKLab palette interpolation over time; null = off.",
      "type": [
        "object",
        "null"
      ],
      "default": null
    },
    "temporalStability": {
      "description": "Anti-flicker Schmitt trigger on the ramp index.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "strength": {
          "type": "number",
          "default": 0.75
        }
      },
      "additionalProperties": true
    },
    "flow": {
      "description": "ETF tuning for selectionMode \"flow\".",
      "type": "object",
      "properties": {
        "coherence": {
          "type": "number",
          "default": 0.3
        },
        "energy": {
          "type": "number",
          "default": 0.06
        },
        "smoothing": {
          "type": "number",
          "default": 2
        }
      },
      "additionalProperties": true
    },
    "recording": {
      "description": "Recording backend.",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "default": "legacy"
        }
      },
      "additionalProperties": true
    },
    "dispersal": {
      "description": "Stardust drift-and-fade effect.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "startT": {
          "type": "number",
          "default": 0.5
        },
        "endT": {
          "type": "number",
          "default": 0.95
        },
        "intensity": {
          "type": "number",
          "default": 0.4
        },
        "upwardBias": {
          "type": "number",
          "default": 0.7
        },
        "swayAmount": {
          "type": "number",
          "default": 0.5
        },
        "rippleAmt": {
          "type": "number",
          "default": 0.2
        }
      },
      "additionalProperties": true
    },
    "studio": {
      "description": "Studio panel, fit-to-image and breathing (EMA) constants.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "fitCanvasToImage": {
          "type": "boolean",
          "default": true
        },
        "breathing": {
          "type": "object",
          "properties": {
            "emaAlpha": {
              "type": "number",
              "default": 0.35
            },
            "gainSwing": {
              "type": "number",
              "default": 0.3
            },
            "jitter": {
              "type": "number",
              "default": 0.05
            },
            "pulseHz": {
              "type": "number",
              "default": 0.7
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "x-unknown-key-policy": "warn",
  "x-preset-version": 1
}
