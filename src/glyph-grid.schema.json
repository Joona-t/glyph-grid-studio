{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joona-t/glyph-grid-studio/schema/preset/v1.json",
  "title": "Glyph Grid Studio preset",
  "description": "A preset is a partial CONFIG: every key is optional and deep-merges onto the renderer defaults. Generated by scripts/gen-schema.js from the live CONFIG — do not edit by hand.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema this preset was written against."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Preset format version.",
      "default": 1
    },
    "compat": {
      "description": "Pipeline generation switch. \"v1\" disables every v2 stage gate.",
      "type": "string",
      "enum": [
        "v1",
        "v2"
      ],
      "default": "v2"
    },
    "renderer": {
      "description": "Render substrate. webgl is opt-in and falls back to cpu.",
      "type": "string",
      "enum": [
        "cpu",
        "webgl"
      ],
      "default": "cpu"
    },
    "canvas": {
      "description": "Canvas size in px before fit-to-image.",
      "type": "object",
      "properties": {
        "w": {
          "type": "number",
          "default": 1024
        },
        "h": {
          "type": "number",
          "default": 504
        }
      },
      "additionalProperties": false
    },
    "grid": {
      "description": "Glyph grid dimensions (cells).",
      "type": "object",
      "properties": {
        "cols": {
          "type": "number",
          "default": 240
        },
        "rows": {
          "type": "number",
          "default": 120
        },
        "salientROIs": {
          "description": "Read by the renderer; no CONFIG default."
        }
      },
      "additionalProperties": false
    },
    "font": {
      "description": "Glyph font family and pixel size.",
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "default": "monospace"
        },
        "size": {
          "type": "number",
          "default": 8
        },
        "cells": {
          "description": "Read by the renderer; no CONFIG default."
        }
      },
      "additionalProperties": false
    },
    "ramp": {
      "description": "Density ramp used by brightness selection.",
      "type": "string",
      "enum": [
        "classic",
        "dense",
        "sparse",
        "unicode-block",
        "gradient",
        "gradientNoSpace",
        "blockShaded",
        "blockAscend",
        "radial"
      ],
      "default": "gradient"
    },
    "brightnessGamma": {
      "description": "Curve on source brightness; <0.5 = high-contrast stipple.",
      "type": "number",
      "default": 0.55
    },
    "bgThreshold": {
      "description": "Source luminance above this renders as palette bg. 0 = off.",
      "type": "number",
      "default": 0
    },
    "invertSignal": {
      "description": "Flip bright/dark so dark detail becomes ink.",
      "type": "boolean",
      "default": false
    },
    "samplingStrategy": {
      "description": "How a cell reads its source pixels.",
      "type": "string",
      "enum": [
        "average",
        "nearest",
        "edge-weighted"
      ],
      "default": "average"
    },
    "colorMode": {
      "description": "How the palette maps to cells.",
      "type": "string",
      "enum": [
        "preserve",
        "monochrome",
        "duotone",
        "gradient"
      ],
      "default": "monochrome"
    },
    "palette": {
      "description": "Background colour + ink stops.",
      "type": "string",
      "enum": [
        "monochrome",
        "phosphor",
        "bauhaus",
        "lovespark",
        "mono-amber",
        "cyber-phosphor",
        "amber-phosphor",
        "bone-charcoal",
        "cream-paper",
        "silver-charcoal",
        "spice",
        "kawaii-pink"
      ],
      "default": "cream-paper"
    },
    "scene": {
      "description": "Built-in scene (studio renders the loaded source).",
      "type": "string",
      "enum": [
        "caduceusHelix",
        "flowField",
        "sparkyPortrait",
        "depthSmoke",
        "studio",
        "concentricRings"
      ],
      "default": "studio"
    },
    "animation": {
      "description": "Loop timing. Frames for `--frames auto` derive from duration x fps.",
      "type": "object",
      "properties": {
        "fps": {
          "type": "number",
          "default": 30
        },
        "duration": {
          "type": "number",
          "default": 6
        },
        "loop": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "seed": {
      "description": "Deterministic seed for noise, dither phase and jitter.",
      "type": "number",
      "default": 1337
    },
    "record": {
      "description": "Internal recording flag.",
      "type": "boolean",
      "default": false
    },
    "glyphSet": {
      "description": "Shape atlas for shape selection modes; null = ramp only.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "ascii",
        "asciiDense",
        "blockElements",
        "braille",
        "octant",
        "sextant"
      ],
      "default": null
    },
    "selectionMode": {
      "description": "How glyphs are picked per cell.",
      "type": "string",
      "enum": [
        "brightness",
        "shape",
        "shape-edge-aware",
        "edge-directional",
        "flow"
      ],
      "default": "brightness"
    },
    "dither": {
      "description": "Quantization noise pattern (brightness selection only).",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "bayer4",
            "bayer8",
            "blueNoise",
            "temporal",
            "stbn",
            "floydSteinberg",
            "atkinson",
            "jarvisJudiceNinke"
          ],
          "default": "temporal"
        },
        "asSourcePrefilter": {
          "type": "boolean",
          "default": true
        },
        "levels": {
          "description": "Read by the renderer; no CONFIG default."
        }
      },
      "additionalProperties": false
    },
    "prefilter": {
      "description": "Source-wide preprocessing.",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "xdog"
          ],
          "default": "none"
        },
        "sigma": {
          "description": "Read by the renderer; no CONFIG default."
        },
        "k": {
          "description": "Read by the renderer; no CONFIG default."
        },
        "tau": {
          "description": "Read by the renderer; no CONFIG default."
        },
        "phi": {
          "description": "Read by the renderer; no CONFIG default."
        },
        "epsilon": {
          "description": "Read by the renderer; no CONFIG default."
        },
        "invert": {
          "description": "Read by the renderer; no CONFIG default."
        }
      },
      "additionalProperties": false
    },
    "postprocess": {
      "description": "Per-stage post effects; each stage has `enabled` plus its params.",
      "type": "object",
      "properties": {
        "vignette": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "strength": {
              "type": "number",
              "default": 0.55
            }
          },
          "additionalProperties": false
        },
        "bloom": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "radius": {
              "type": "number",
              "default": 2.5
            },
            "strength": {
              "type": "number",
              "default": 0.95
            },
            "threshold": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "intensity": {
              "description": "Read by the renderer; no CONFIG default."
            }
          },
          "additionalProperties": false
        },
        "halation": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "strength": {
              "type": "number",
              "default": 0.7
            },
            "threshold": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "intensity": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "radius": {
              "description": "Read by the renderer; no CONFIG default."
            }
          },
          "additionalProperties": false
        },
        "scanlines": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "period": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "intensity": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "phase": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "strength": {
              "description": "Read by the renderer; no CONFIG default."
            }
          },
          "additionalProperties": false
        },
        "chromaticAberration": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "amount": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "offset": {
              "description": "Read by the renderer; no CONFIG default."
            }
          },
          "additionalProperties": false
        },
        "phosphorDecay": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "decayFactor": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "decay": {
              "description": "Read by the renderer; no CONFIG default."
            }
          },
          "additionalProperties": false
        },
        "depthFog": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "strength": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "intensity": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "start": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "end": {
              "description": "Read by the renderer; no CONFIG default."
            },
            "color": {
              "description": "Read by the renderer; no CONFIG default."
            }
          },
          "additionalProperties": false
        },
        "crtBeam": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "intensity": {
              "type": "number",
              "default": 0.45
            },
            "beamWidth": {
              "type": "number",
              "default": 0.18
            },
            "speed": {
              "type": "number",
              "default": 1
            },
            "slotMask": {
              "type": "boolean",
              "default": true
            },
            "slotStrength": {
              "type": "number",
              "default": 0.2
            },
            "beamY": {
              "description": "Read by the renderer; no CONFIG default."
            }
          },
          "additionalProperties": false
        },
        "kawaii": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "intensity": {
              "type": "number",
              "default": 0.85
            },
            "heartCount": {
              "type": "number",
              "default": 12
            },
            "sparkleCount": {
              "type": "number",
              "default": 28
            },
            "twinkleCount": {
              "type": "number",
              "default": 60
            },
            "speed": {
              "type": "number",
              "default": 1
            },
            "hueR": {
              "type": "number",
              "default": 255
            },
            "hueG": {
              "type": "number",
              "default": 105
            },
            "hueB": {
              "type": "number",
              "default": 180
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "depth": {
      "description": "Depth-map fog zones.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "paletteMorph": {
      "description": "OKLab palette interpolation over time; null = off.",
      "type": [
        "object",
        "null"
      ],
      "default": null
    },
    "timeline": {
      "description": "Keyframe tracks on dotted CONFIG paths, evaluated per frame (u = t / animation.duration).",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "tracks": {
          "type": "object",
          "description": "Dotted CONFIG path -> keyframes.",
          "propertyNames": {
            "pattern": "^[A-Za-z_$][\\w$]*(\\.[A-Za-z_$][\\w$]*)*$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "u",
                "v"
              ],
              "properties": {
                "u": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Loop position of this key."
                },
                "v": {
                  "description": "Value at u: a number (lerped), a palette name on the `palette` track (OKLab blend), anything else steps."
                },
                "ease": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "inOutSine",
                    "step"
                  ],
                  "default": "linear",
                  "description": "Shape of the segment arriving at this key. Forced to step on grid.cols, grid.rows, glyphSet, selectionMode, dither.mode."
                }
              },
              "additionalProperties": false
            }
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "textSource": {
      "description": "Kinetic typography: text (or SRT/LRC cues) rendered per frame as the source raster.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "w": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096,
          "default": 1024,
          "description": "Text canvas width (px)."
        },
        "h": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096,
          "default": 512,
          "description": "Text canvas height (px)."
        },
        "bg": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "default": "#000000"
        },
        "fg": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "default": "#ffffff"
        },
        "blend": {
          "type": "string",
          "enum": [
            "replace",
            "multiply",
            "screen",
            "mask"
          ],
          "default": "replace",
          "description": "With an image loaded: replace = text only; multiply / screen / mask composite in linear light."
        },
        "font": {
          "type": "string",
          "minLength": 1,
          "default": "Cascadia Mono",
          "description": "Font family: Cascadia Mono / IBM VGA8 (bundled) or a system font."
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 160,
          "description": "px at the text canvas height h."
        },
        "weight": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000,
          "default": 700
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "center"
        },
        "x": {
          "type": "number",
          "default": 0.5,
          "description": "Anchor, 0..1 of the canvas width."
        },
        "y": {
          "type": "number",
          "default": 0.5,
          "description": "Anchor (row centre), 0..1 of the canvas height."
        },
        "anim": {
          "type": "string",
          "enum": [
            "none",
            "typewriter",
            "rise",
            "fade",
            "scale"
          ],
          "default": "none"
        },
        "easeIn": {
          "type": "number",
          "minimum": 0,
          "default": 0.3,
          "description": "Seconds of the in-envelope."
        },
        "easeOut": {
          "type": "number",
          "minimum": 0,
          "default": 0.2,
          "description": "Seconds of the out-envelope before a finite end."
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "description": "Line text; \\n stacks rows."
              },
              "start": {
                "type": "number",
                "minimum": 0,
                "description": "Seconds; default 0."
              },
              "end": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "Seconds, exclusive; null = until the loop ends."
              },
              "font": {
                "type": "string",
                "minLength": 1,
                "description": "Font family: Cascadia Mono / IBM VGA8 (bundled) or a system font."
              },
              "size": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "px at the text canvas height h."
              },
              "weight": {
                "type": "number",
                "minimum": 1,
                "maximum": 1000
              },
              "align": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              },
              "x": {
                "type": "number",
                "description": "Anchor, 0..1 of the canvas width."
              },
              "y": {
                "type": "number",
                "description": "Anchor (row centre), 0..1 of the canvas height."
              },
              "anim": {
                "type": "string",
                "enum": [
                  "none",
                  "typewriter",
                  "rise",
                  "fade",
                  "scale"
                ]
              },
              "easeIn": {
                "type": "number",
                "minimum": 0,
                "description": "Seconds of the in-envelope."
              },
              "easeOut": {
                "type": "number",
                "minimum": 0,
                "description": "Seconds of the out-envelope before a finite end."
              }
            },
            "additionalProperties": false
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "video": {
      "description": "Video sources (mp4 / mov / m4v / webm as the input): decoder choice and the GUI camera.",
      "type": "object",
      "properties": {
        "decode": {
          "type": "string",
          "enum": [
            "auto",
            "native",
            "webview"
          ],
          "default": "auto",
          "description": "auto = H.264 MP4/MOV via the Rust openh264 decoder (frame-exact), other codecs via the WebView <video>; native = Rust only (non-H.264 is an error); webview = always the <video> seek path."
        },
        "camera": {
          "type": "boolean",
          "default": false,
          "description": "GUI only (experimental): the webcam is the source while on. Ignored headless."
        },
        "mirror": {
          "type": "boolean",
          "default": true,
          "description": "Mirror the camera image."
        }
      },
      "additionalProperties": false
    },
    "temporalStability": {
      "description": "Anti-flicker Schmitt trigger on the ramp index.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "strength": {
          "type": "number",
          "default": 0.75
        }
      },
      "additionalProperties": true
    },
    "flow": {
      "description": "ETF tuning for selectionMode \"flow\".",
      "type": "object",
      "properties": {
        "coherence": {
          "type": "number",
          "default": 0.3
        },
        "energy": {
          "type": "number",
          "default": 0.06
        },
        "smoothing": {
          "type": "number",
          "default": 2
        }
      },
      "additionalProperties": true
    },
    "recording": {
      "description": "Recording backend.",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "default": "legacy"
        }
      },
      "additionalProperties": true
    },
    "dispersal": {
      "description": "Stardust drift-and-fade effect.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "startT": {
          "type": "number",
          "default": 0.5
        },
        "endT": {
          "type": "number",
          "default": 0.95
        },
        "intensity": {
          "type": "number",
          "default": 0.4
        },
        "upwardBias": {
          "type": "number",
          "default": 0.7
        },
        "swayAmount": {
          "type": "number",
          "default": 0.5
        },
        "rippleAmt": {
          "type": "number",
          "default": 0.2
        }
      },
      "additionalProperties": true
    },
    "studio": {
      "description": "Studio panel, fit-to-image and breathing (EMA) constants.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "fitCanvasToImage": {
          "type": "boolean",
          "default": true
        },
        "gpuPreprocess": {
          "type": "boolean",
          "default": true
        },
        "breathing": {
          "type": "object",
          "properties": {
            "emaAlpha": {
              "type": "number",
              "default": 0.35
            },
            "gainSwing": {
              "type": "number",
              "default": 0.3
            },
            "jitter": {
              "type": "number",
              "default": 0.05
            },
            "pulseHz": {
              "type": "number",
              "default": 0.7
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "x-unknown-key-policy": "warn",
  "x-preset-version": 1
}
